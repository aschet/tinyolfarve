# Inherits the parent config, minus magic-number checks (busywork against
# test literals) and misc-include-cleaner (false positives against Unity's
# unannotated headers).
InheritParentConfig: true
Checks: >
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -misc-include-cleaner
